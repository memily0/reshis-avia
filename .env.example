# Постоянный путь на подключённом диске сервера
RESHIS_AVIA_DB=/var/lib/reshis-avia/users.db

# В production с HTTPS значение должно быть true
RESHIS_AVIA_COOKIE_SECURE=true

# Публичный адрес приложения; несколько адресов разделяются запятыми
RESHIS_AVIA_ALLOWED_ORIGINS=https://avia.example.com

# Используется в команде запуска Uvicorn на платформе
PORT=8000
